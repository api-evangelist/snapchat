{
  "opencollection": "1.0.0",
  "info": {
    "name": "Snapchat Ads Ad Accounts User Profile API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://accounts.snapchat.com/accounts/oauth2/auth",
      "accessTokenUrl": "https://accounts.snapchat.com/login/oauth2/access_token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "User Profile",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Authenticated User Profile",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://adsapi.snapchat.com/v1/me",
            "params": [
              {
                "name": "query",
                "value": "",
                "type": "query",
                "description": "A JSON-encoded query string specifying which fields to retrieve from the user profile."
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "authorization_code",
              "authorizationUrl": "https://accounts.snapchat.com/accounts/oauth2/auth",
              "accessTokenUrl": "https://accounts.snapchat.com/login/oauth2/access_token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Retrieves the profile information of the authenticated Snapchat user, including their external ID, display name, and Bitmoji avatar URL based on the scopes granted during authorization."
        }
      ]
    }
  ],
  "bundled": true
}