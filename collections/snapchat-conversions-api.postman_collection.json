      "item": [
        {
          "id": "8940d776-6321-4601-a080-261c15823632",
          "name": "Send Web Conversion Events",
          "request": {
            "name": "Send Web Conversion Events",
            "description": {
              "content": "Sends one or more web conversion events to Snap using a Pixel ID. Events can include purchases, page views, add-to-cart actions, sign-ups, and other custom conversion events. Multiple events can be sent in a single request (up to 2,000 per request). Events can have a timestamp of up to 37 days in the past.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                ":pixel_id",
                "events"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "access_token",
                  "value": "<string>",
                  "description": "(Required) The static long-lived access token for authentication."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "pixel_id",
                  "description": "(Required) The Snap Pixel ID used for tracking web conversion events."
                }
              ]
