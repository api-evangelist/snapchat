  "info": {
    "_postman_id": "ae878246-e863-4fac-8cb4-d95d6ad24b19",
    "name": "Snapchat Login Kit API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Snapchat Login Kit enables developers to let users sign up and log in to their apps using their Snapchat account credentials. Built on the OAuth 2.0 standard, it provides endpoints for authorization, token exchange, token refresh, and retrieving user profile information including display name and Bitmoji avatar. Login Kit is available for iOS, Android, and Web platforms.\n\nContact Support:\n Name: Snap for Developers",
      "type": "text/plain"
    }
  }
