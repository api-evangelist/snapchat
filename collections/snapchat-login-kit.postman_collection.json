    {
      "id": "ba904da0-77e1-44d3-bfcb-2c1b6fad18d8",
      "name": "User Profile",
      "description": {
        "content": "Endpoints for retrieving authenticated user profile information including display name and Bitmoji avatar.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "f55b1435-570c-4d63-af56-10139afc3b9f",
          "name": "Get Authenticated User Profile",
          "request": {
            "name": "Get Authenticated User Profile",
            "description": {
              "content": "Retrieves the profile information of the authenticated Snapchat user, including their external ID, display name, and Bitmoji avatar URL based on the scopes granted during authorization.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "me"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "query",
                  "value": "<string>",
                  "description": "A JSON-encoded query string specifying which fields to retrieve from the user profile."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            }
          },
          "response": [
            {
              "id": "12e67915-e72f-453f-8672-6393d687b718",
              "name": "User profile retrieved successfully",
