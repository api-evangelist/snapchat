              "body": "{\n  \"data\": {\n    \"me\": {\n      \"externalId\": \"string\",\n      \"displayName\": \"string\",\n      \"bitmoji\": {\n        \"avatar\": \"https://gabyQTYsJsfGlUX.vvvmFxJ1Ocfzsn8yceqzrizGtV.lg9nnhB5vF8kXQox\",\n        \"id\": \"string\"\n      }\n    }\n  }\n}",
