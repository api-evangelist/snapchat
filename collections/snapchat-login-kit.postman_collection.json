      "id": "42da7b1a-ccdf-40b6-855d-5be361741d03",
      "name": "OAuth",
      "description": {
        "content": "OAuth 2.0 authorization and token management endpoints for authenticating users via their Snapchat account.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "efe7118d-509f-4f41-b7c4-d77abb3da0ca",
          "name": "Authorize a User via Snapchat",
          "request": {
            "name": "Authorize a User via Snapchat",
            "description": {
              "content": "Redirects the user to the Snapchat authorization page where they can grant permission to the application. This is the initial step in the OAuth 2.0 authorization code flow. After authorization, the user is redirected back to the specified redirect URI with an authorization code.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "accounts",
                "oauth2",
                "auth"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "client_id",
                  "value": "<string>",
                  "description": "(Required) The OAuth client ID assigned to the application."
                },
                {
                  "disabled": false,
                  "key": "redirect_uri",
                  "value": "<uri>",
                  "description": "(Required) The URI to redirect the user to after authorization. Must match one of the registered redirect URIs."
                },
                {
                  "disabled": false,
                  "key": "response_type",
                  "value": "<string>",
                  "description": "(Required) The OAuth response type. Use 'code' for authorization code flow or 'token' for implicit flow."
                },
                {
                  "disabled": false,
                  "key": "scope",
                  "value": "<string>",
                  "description": "(Required) Space-separated list of requested scopes defining what user data the application wants access to."
                },
                {
                  "disabled": false,
                  "key": "state",
                  "value": "<string>",
                  "description": "An opaque value used to maintain state between the request and callback for CSRF protection."
                }
              ],
              "variable": []
            },
            "method": "GET",
            "auth": null
          },
          "response": [
