                {
                  "name": "Authorize a User via Snapchat",
                  "id": "8021f665-f8eb-4c15-a050-6c331c22bcad",
                  "protocolProfileBehavior": {
                    "disableBodyPruning": true
                  },
                  "request": {
                    "method": "GET",
                    "header": [],
                    "url": {
                      "raw": "{{baseUrl}}/accounts/oauth2/auth?client_id=<string>&redirect_uri=<uri>&response_type=token&scope=<string>&state=<string>",
                      "host": [
                        "{{baseUrl}}"
                      ],
                      "path": [
                        "accounts",
                        "oauth2",
                        "auth"
                      ],
                      "query": [
                        {
                          "description": "(Required) The OAuth client ID assigned to the application.",
                          "key": "client_id",
                          "value": "<string>"
                        },
                        {
                          "description": "(Required) The URI to redirect the user to after authorization. Must match one of the registered redirect URIs.",
                          "key": "redirect_uri",
                          "value": "<uri>"
                        },
                        {
                          "description": "(Required) The OAuth response type. Use 'code' for authorization code flow or 'token' for implicit flow.",
                          "key": "response_type",
                          "value": "token"
                        },
                        {
                          "description": "(Required) Space-separated list of requested scopes defining what user data the application wants access to.",
                          "key": "scope",
                          "value": "<string>"
                        },
                        {
                          "description": "An opaque value used to maintain state between the request and callback for CSRF protection.",
                          "key": "state",
                          "value": "<string>"
                        }
                      ]
                    },
                    "description": "Redirects the user to the Snapchat authorization page where they can grant permission to the application. This is the initial step in the OAuth 2.0 authorization code flow. After authorization, the user is redirected back to the specified redirect URI with an authorization code."
                  },
