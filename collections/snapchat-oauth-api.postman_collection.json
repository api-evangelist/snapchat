                  "id": "e6e2790c-d6be-4bee-99a3-ede2d413ac1a",
                  "protocolProfileBehavior": {
                    "disableBodyPruning": true
                  },
                  "request": {
                    "method": "POST",
                    "header": [
                      {
                        "key": "Content-Type",
                        "value": "application/x-www-form-urlencoded"
                      },
                      {
                        "key": "Accept",
                        "value": "application/json"
                      }
                    ],
                    "body": {
                      "mode": "urlencoded",
                      "urlencoded": [
                        {
                          "description": "(Required) The OAuth client ID assigned to the application.",
                          "key": "client_id",
                          "value": "<string>"
                        },
                        {
                          "description": "(Required) The OAuth client secret assigned to the application.",
                          "key": "client_secret",
                          "value": "<string>"
                        },
                        {
                          "description": "(Required) The type of token exchange. Use 'authorization_code' for initial exchange or 'refresh_token' for renewal.",
                          "key": "grant_type",
                          "value": "refresh_token"
                        },
                        {
                          "description": "The authorization code received from the authorization endpoint. Required when grant_type is authorization_code.",
                          "key": "code",
                          "value": "<string>"
                        },
                        {
                          "description": "The redirect URI used in the authorization request. Required when grant_type is authorization_code.",
                          "key": "redirect_uri",
                          "value": "<uri>"
                        },
                        {
                          "description": "The refresh token for obtaining a new access token. Required when grant_type is refresh_token.",
                          "key": "refresh_token",
                          "value": "<string>"
                        }
                      ]
                    },
                    "url": {
                      "raw": "{{baseUrl}}/login/oauth2/access_token",
                      "host": [
                        "{{baseUrl}}"
                      ],
                      "path": [
                        "login",
                        "oauth2",
                        "access_token"
                      ]
                    },
                    "description": "Exchanges an authorization code for an access token and refresh token. Access tokens expire after 3600 seconds (60 minutes). This endpoint is also used to refresh expired access tokens using a refresh token."
