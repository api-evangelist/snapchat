    "_postman_id": "8f462a6d-909d-426a-8282-322d8fccaca6",
    "name": "Snapchat Login Kit OAuth API",
    "description": "Snapchat Login Kit enables developers to let users sign up and log in to their apps using their Snapchat account credentials. Built on the OAuth 2.0 standard, it provides endpoints for authorization, token exchange, token refresh, and retrieving user profile information including display name and Bitmoji avatar. Login Kit is available for iOS, Android, and Web platforms.\n\nContact Support:\n Name: Snap for Developers",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "createdAt": "2026-10-21T20:12:46.000Z",
    "updatedAt": "2026-10-21T20:12:47.000Z",
    "lastUpdatedBy": "35240",
    "uid": "35240-8f462a6d-909d-426a-8282-322d8fccaca6"
  },
