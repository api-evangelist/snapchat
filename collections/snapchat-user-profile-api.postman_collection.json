  "info": {
    "_postman_id": "35aef1b8-95ba-4f9b-b782-c5445ac2241a",
    "name": "Snapchat Login Kit User Profile API",
    "description": "Snapchat Login Kit enables developers to let users sign up and log in to their apps using their Snapchat account credentials. Built on the OAuth 2.0 standard, it provides endpoints for authorization, token exchange, token refresh, and retrieving user profile information including display name and Bitmoji avatar. Login Kit is available for iOS, Android, and Web platforms.\n\nContact Support:\n Name: Snap for Developers",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "createdAt": "2026-10-21T20:12:41.000Z",
    "updatedAt": "2026-10-21T20:12:41.000Z",
    "lastUpdatedBy": "35240",
    "uid": "35240-35aef1b8-95ba-4f9b-b782-c5445ac2241a"
  },
  "item": [
    {
      "name": "me",
      "item": [
        {
          "name": "Get Authenticated User Profile",
          "id": "01c32925-fb21-4349-9f08-6c0ff7e27228",
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          },
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/me?query=<string>",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "me"
              ],
              "query": [
                {
                  "description": "A JSON-encoded query string specifying which fields to retrieve from the user profile.",
                  "key": "query",
                  "value": "<string>"
                }
              ]
            },
            "description": "Retrieves the profile information of the authenticated Snapchat user, including their external ID, display name, and Bitmoji avatar URL based on the scopes granted during authorization."
          },
          "response": [
            {
              "id": "73c8cc1d-a813-4a09-bc07-db54457d4eb6",
              "name": "User profile retrieved successfully",
